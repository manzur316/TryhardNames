{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "concurrently --kill-others --raw \"npm run start --prefix apps/api\" \"npm run start --prefix apps/pocketbase\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\" \"npm run lint --prefix apps/api\"",
    "test": "npm run test --prefix apps/web",
    "test:api": "npm run test --prefix apps/api",
    "test:seo": "npm run test:seo --prefix apps/web",
    "test:passport": "npm run test:passport --prefix apps/web",
    "test:auth": "npm run test:auth --prefix apps/web",
    "test:auth:local": "node scripts/run-auth-local-test.mjs",
    "db:start": "npx supabase@2.84.2 start",
    "db:reset": "npx supabase@2.84.2 db reset",
    "test:db": "npx supabase@2.84.2 test db",
    "db:stop": "npx supabase@2.84.2 stop --no-backup"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
