# apps/web - copy to .env locally. Never commit real secrets.

# API base used by the web app.
VITE_API_URL=/hcgi/api

# Optional production template banner injection.
TEMPLATE_BANNER_SCRIPT_URL=
TEMPLATE_REDIRECT_URL=

# Local Supabase Parent Auth. Copy from `supabase status -o env`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_GOOGLE_ENABLED=false
