# apps/api - copy to .env locally. Never commit real secrets.

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Public app origin used by export and existing Pinterest helpers.
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
VERCEL_URL=

# PocketBase local/defaults.
POCKETBASE_URL=http://127.0.0.1:8090
WEBSITE_DOMAIN=localhost
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Existing Pinterest integration. Leave empty unless operating these routes.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_STATE_SECRET=
PINTEREST_TOKEN_ENDPOINT=https://api.pinterest.com/v5/oauth/token
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_SCOPES=boards:read,pins:read,pins:write,user_accounts:read

# RM-27 osu! Runtime Foundation. Disabled by default; never commit real values.
OSU_PROVIDER_ENABLED=false
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=
OSU_STATE_SECRET=
OSU_AUTHORIZATION_URL=https://osu.ppy.sh/oauth/authorize
OSU_TOKEN_ENDPOINT=https://osu.ppy.sh/oauth/token
OSU_API_BASE_URL=https://osu.ppy.sh/api/v2
OSU_SCOPES=identify public

# Server-only Supabase admin boundary for API routes. Never expose this to apps/web.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
